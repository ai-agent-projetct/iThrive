# Dependencies
/vendor/
.tools/node_modules/
.tools/package-lock.json
composer.lock

# Secrets — never commit an API key
includes/secrets.php
.env

# Runtime data: enquiries, conversations, leads, AI drafts
storage/*.ndjson
storage/replies/

# Derived, and rebuilt on demand: the FAQ corpus/index and the Sarvam
# translation cache. Thousands of small files that are not source.
storage/cache/

# A CA bundle with a local TLS-inspecting root (Avast, Kaspersky, a corporate
# proxy) appended. Machine-specific by definition — see curl_ca_bundle().
includes/certs/local-cacert.pem

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Built React page: source is app/mobile, output is committed
app/mobile/node_modules/

# Tool output, not source.
graphify-out/
# Local Claude Code state. launch.json is shared (see below); this is not.
.claude/settings.local.json
.photo-tmp/

# Photography run scratch
.photo-run.log
.photo-tmp/

# Temporary run screenshots and scratch files in root
/*.png
/*.jpg
scratch/
scratch_*.js
test-puter.html

# Dev server output. Can contain a pasted API key from the launch command line.
server.log
.tools/sarvam-result.txt

# Pre-trim copies of the section images, kept locally as a safety net.
assets/img/services/_original/

# Pre-photo copies of section images, kept locally as a safety net.
assets/img/services/_replaced_by_photos/
assets/img/services/_old_sections/
assets/img/case-hero/_replaced/
assets/img/_dedupe_backup/
assets/img/_home_backup/
