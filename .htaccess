# Ithrive Software Solutions — Apache configuration.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Allow extensionless URLs: /services/cloud-devops -> /services/cloud-devops.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# Enquiries, secrets, templates, dependencies and tooling are never served
# directly — only handlers/ and the page routes are public.
RedirectMatch 404 ^/(storage|includes|vendor|\.tools)/
RedirectMatch 404 ^/composer\.(json|lock)$

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Asset URLs are cache-busted by filemtime, so a long TTL is safe.
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresDefault                        "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /404.php
