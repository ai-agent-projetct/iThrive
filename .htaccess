# Ithrive Software Solutions — Apache configuration.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The sitemap is generated by PHP but must be served at the conventional path.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^llms\.txt$ llms.php [L]

  # Allow extensionless URLs: /services/cloud-devops -> /services/cloud-devops.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# Enquiries, secrets, templates, dependencies and tooling are never served
# directly — only handlers/ and the page routes are public.
#
# app/ holds the React and OriginKit sources that the committed bundles in
# assets/dist are built from. It was missing from this list, so the live site
# answered a request for app/mobile/src/App.jsx with the file. Nothing at
# runtime reads from app/ — the only reference anywhere is robots.txt, which
# already asked crawlers to leave it alone.
RedirectMatch 404 ^/(storage|includes|vendor|app|docs|graphify-out|\.tools|\.github)/
RedirectMatch 404 ^/composer\.(json|lock)$

# Repository metadata. The deploy stopped uploading these, but earlier manual
# uploads may already have put them on the server, and README.md describes the
# deployment and the AI spending caps.
RedirectMatch 404 ^/(README\.md|package(-lock)?\.json)$

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Asset URLs are cache-busted by filemtime, so a long TTL is safe.
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresDefault                        "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /404.php
